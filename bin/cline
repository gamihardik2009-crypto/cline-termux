#!@PREFIX@/bin/sh
#
# cline -- Cline CLI launcher for Termux/Android (aarch64)
#
# Part of the cline-termux packaging prototype.  This launcher hides the
# bun-termux / glibc compatibility layer behind the plain `cline` command.
#
# Layout it expects (created by install.sh):
#   $PREFIX/bin/cline           this launcher
#   $PREFIX/lib/cline/cline     Cline standalone ELF (Bun-compiled)
#   $PREFIX/lib/cline/bun-termux   bun-termux wrapper ELF
#   $PREFIX/lib/cline/bun-shim.so  LD_PRELOAD shim (glibc)
#
# Do not edit this file directly; re-run install.sh to regenerate it.

set -u

# --- Resolve the real location of this script (follow symlinks) -----------
SELF="$0"
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF") || break
    case "$LINK" in
        /*) SELF="$LINK" ;;
        *)  SELF="$(dirname -- "$SELF")/$LINK" ;;
    esac
done
BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd) || exit 1
PREFIX=$(CDPATH= cd -- "$BIN_DIR/.." && pwd) || exit 1

# --- Installation layout ---------------------------------------------------
CLINE_LIB="$PREFIX/lib/cline"
CLINE_BIN="$CLINE_LIB/cline"
WRAPPER="$CLINE_LIB/bun-termux"

# --- Environment -----------------------------------------------------------
export PREFIX

# Termux normally sets TMPDIR to $PREFIX/tmp.  Make sure it exists and is
# exported so the runtime's temp handling (and the shim's /tmp redirects)
# work even when cline is started from a non-login shell.
if [ -z "${TMPDIR:-}" ]; then
    export TMPDIR="$PREFIX/tmp"
fi
if [ ! -d "$TMPDIR" ]; then
    mkdir -p "$TMPDIR" 2>/dev/null || true
fi

# Skip Cline's background startup update-check. On a standalone (Bun-compiled)
# binary its update path can't install anything anyway, and skipping it avoids
# a registry round-trip at every launch. Use `cline update` explicitly.
export CLINE_NO_AUTO_UPDATE=1

# Point the bun-termux wrapper at the Cline ELF (a standalone Bun-compiled
# executable).  The wrapper loads it through the glibc loader with the
# bun-shim.so shim preloaded.
export BUN_BINARY_PATH="$CLINE_BIN"

# --- Run -------------------------------------------------------------------
if [ ! -x "$WRAPPER" ]; then
    echo "cline: runtime wrapper not found: $WRAPPER" >&2
    echo "cline: re-run install.sh or reinstall the cline-termux package" >&2
    exit 127
fi
if [ ! -x "$CLINE_BIN" ]; then
    echo "cline: Cline binary not found: $CLINE_BIN" >&2
    echo "cline: re-run install.sh or reinstall the cline-termux package" >&2
    exit 127
fi

exec "$WRAPPER" "$@"